{
  "name": "shared-cognito-auth-lib",
  "version": "0.0.0",
  "description": "Shared AWS Cognito authentication, SSO and MongoDB-backed authorization for Node services",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "readme.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "example": "node --env-file=examples/express-app/.env examples/express-app/index.js"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "express": ">=4",
    "mongodb": ">=6"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
