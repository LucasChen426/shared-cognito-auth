# Copy to .env and fill in. Never commit .env.

# --- Your service ---
PORT=3000
# Public URL of this service; the Cognito callback is <APP_ORIGIN>/auth/callback
APP_ORIGIN=http://localhost:3000

# --- MongoDB (sessions and roles are stored here) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=myservice

# --- AWS Cognito ---
# Same user pool for every service that should share SSO; one app client per service.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id
# Only if the app client was created with a secret
COGNITO_CLIENT_SECRET=
# Cognito domain, without https://
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# --- Session encryption ---
# At least 32 random characters, for example: openssl rand -base64 48
# Use the same value on every instance of this service. Changing it signs everyone out.
SESSION_SECRET=
